{
  "name": "poke",
  "version": "0.1.0",
  "private": true,
  "description": "Poke at the app you're developing. A code buffer beside a live page.",
  "main": "dist/main/index.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "install-electron",
    "build": "tsc -p tsconfig.main.json && node scripts/build-queries.mjs && vite build",
    "start": "pnpm build && electron .",
    "smoke": "node test/smoke.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@testing-library/dom": "^10.4.1",
    "@vitest/expect": "^5.0.0",
    "@vitest/pretty-format": "^5.0.0",
    "@vitest/utils": "^5.0.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vue": "^3.5.43"
  }
}
